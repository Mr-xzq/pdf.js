{
  "compilerOptions": {
    "target": "es5",
    "module": "esnext",
    "baseUrl": "./",
    "moduleResolution": "node",
    "paths": {
      "@/*": ["src/*"],
      "global-pdfjs-dist/*": ["../../pdfjs-dist/*"],
      "local-pdfjs-dist/*": ["public/lib/pdfjs-dist/*"]
    },
    "lib": ["esnext", "dom", "dom.iterable", "scripthost"]
  }
}
